{
  "name": "node-librados (Squid)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {"CEPH_RELEASE": "squid", "NODE_MAJOR": "24"}
  },
  "remoteUser": "root",
  "containerEnv": {
    "CEPH_INTEGRATION": "1",
    "CEPH_CONF": "/tmp/node-librados-ceph/ceph.conf"
  },
  "postCreateCommand": "npm ci && npm run build",
  "postStartCommand": "scripts/micro-ceph.sh"
}
